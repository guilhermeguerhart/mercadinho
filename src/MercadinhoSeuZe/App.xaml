        <Geometry x:Key="IconeFloco">M12 3v18 M4.2 7.5l15.6 9 M4.2 16.5l15.6 -9 M9.5 4.5L12 7l2.5 -2.5 M9.5 19.5L12 17l2.5 2.5</Geometry>
        <Geometry x:Key="IconeFolha">M5 19C5 10 10 5 20 4c-1 10-6 15-15 15z M5 19l8-8</Geometry>
        <Geometry x:Key="IconeBolhas">M4 15a5 5 0 1 0 10 0a5 5 0 1 0 -10 0 M14 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0 M15 15a2 2 0 1 0 4 0a2 2 0 1 0 -4 0</Geometry>
        <Geometry x:Key="IconeGota">M12 3c4 5 6 8 6 11a6 6 0 0 1 -12 0c0-3 2-6 6-11z</Geometry>
