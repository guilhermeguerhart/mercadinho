<Application x:Class="MercadinhoSeuZe.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Cores do mercado: verde de hortifrúti e amarelo de etiqueta de preço -->
        <SolidColorBrush x:Key="Fundo" Color="#F3F6F1" />
        <SolidColorBrush x:Key="Superficie" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Texto" Color="#1D2A22" />
        <SolidColorBrush x:Key="TextoSuave" Color="#5D6B62" />
        <SolidColorBrush x:Key="Linha" Color="#D9E2DA" />
        <SolidColorBrush x:Key="Verde" Color="#1F6B45" />
        <SolidColorBrush x:Key="VerdeEscuro" Color="#17543A" />
        <SolidColorBrush x:Key="Amarelo" Color="#F2C230" />
        <SolidColorBrush x:Key="Erro" Color="#B3261E" />

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Texto}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Titulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style x:Key="Rotulo" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="Campo" TargetType="Control">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{StaticResource Superficie}" />
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource Campo}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Campo}" />

        <Style x:Key="BotaoPrincipal" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Verde}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="22,11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource VerdeEscuro}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Borda" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoSecundario" TargetType="Button" BasedOn="{StaticResource BotaoPrincipal}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Verde}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="6"
                                BorderBrush="{StaticResource Verde}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="Background" Value="#E1F0E6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cartao" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Superficie}" />
            <Setter Property="BorderBrush" Value="{StaticResource Linha}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <!-- Etiqueta amarela de gôndola, usada como marca visual -->
        <Style x:Key="Etiqueta" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Amarelo}" />
            <Setter Property="CornerRadius" Value="4,14,14,4" />
            <Setter Property="Padding" Value="12,4,16,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </Application.Resources>
</Application>
