<UserControl x:Class="MercadinhoSeuZe.Views.EmDesenvolvimentoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Width="420" Margin="16,24" VerticalAlignment="Center" HorizontalAlignment="Center">
            <DockPanel Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal">
                    <Border Style="{StaticResource MarcaQuadrado}">
                        <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Mercado" FontWeight="Bold" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="← Voltar ao site" Style="{StaticResource LinkSuave}" HorizontalAlignment="Right"
                        VerticalAlignment="Center" Click="Sair_Click" />
            </DockPanel>

            <Border Style="{StaticResource CartaoBorda}" CornerRadius="16" Padding="32,28,32,24" Effect="{StaticResource SombraCartao}">
                <StackPanel>
                    <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource Ambar50}" Margin="0,0,0,16">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeFerramenta}" Foreground="{StaticResource Ambar700}" Width="26" />
                    </Border>
                    <TextBlock x:Name="Ola" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Verde700}"
                               TextAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Esta área ainda está em desenvolvimento" FontSize="26" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="Estamos construindo o sistema por partes. Em breve, ao entrar, você vai direto para a sua tela de trabalho."
                               Style="{StaticResource TextoSuave}" FontSize="14" TextAlignment="Center" Margin="0,0,0,24" />

                    <Border Background="{StaticResource Fundo}" CornerRadius="10" Padding="16,14" Margin="0,0,0,24">
                        <ItemsControl x:Name="Proximas">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,4">
                                        <Ellipse Width="8" Height="8" Fill="{StaticResource Ambar700}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding}" FontSize="14" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <Button Content="Sair" Style="{StaticResource BotaoPrimario}" Height="48" FontSize="16" Click="Sair_Click" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource TextoSuave}" FontSize="13" TextAlignment="Center" Margin="0,16,0,0">
                Dúvidas? <Run Text="contato@mercado.com.br" Foreground="{StaticResource Verde700}" FontWeight="SemiBold" /> · (11) 4000-0000
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</UserControl>
