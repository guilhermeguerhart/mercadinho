<UserControl x:Class="MercadinhoSeuZe.Views.EnvioPedidoJanela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="560">
    <!-- Envio do pedido: WhatsApp ou e-mail já com a mensagem escrita -->
    <Border Style="{StaticResource CartaoBorda}" CornerRadius="16" Padding="24,24,24,20" Effect="{StaticResource SombraJanela}">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource LinkSuave}" FontSize="24" FontWeight="Normal"
                        VerticalAlignment="Top" Click="Fechar_Click" ToolTip="Fechar" AutomationProperties.Name="Fechar" />
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="22" Background="{StaticResource Verde50}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeEnviar}" Foreground="{StaticResource Verde700}" Width="20" />
                </Border>
                <StackPanel>
                    <TextBlock x:Name="Titulo" FontSize="22" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock x:Name="Subtitulo" FontSize="14" Style="{StaticResource TextoSuave}" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="Mensagem" Style="{StaticResource Rotulo}" />
            <TextBox x:Name="Mensagem" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="170" MaxHeight="340" VerticalContentAlignment="Top"
                     Padding="14,10" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Mensagem do pedido" />
            <TextBlock FontSize="12" Style="{StaticResource TextoSuave}" Margin="0,6,0,0"
                       Text="Pode mudar o texto aqui. O WhatsApp (ou o e-mail) abre com a mensagem escrita: confira e aperte enviar. O programa não envia nada sozinho." />

            <UniformGrid x:Name="BotoesEnvio" Rows="1" Margin="0,20,0,0">
                <Button x:Name="BotaoWhatsapp" Style="{StaticResource BotaoPrimario}" Click="Whatsapp_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeMensagem}" Foreground="White" Width="17" Margin="0,0,8,0" />
                        <TextBlock Text="Enviar pelo WhatsApp" />
                    </StackPanel>
                </Button>
                <Button x:Name="BotaoEmail" Style="{StaticResource BotaoFantasma}" Margin="10,0,0,0" Click="Email_Click">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeEmail}" Foreground="{StaticResource Verde700}" Width="17" Margin="0,0,8,0" />
                        <TextBlock Text="Enviar por e-mail" />
                    </StackPanel>
                </Button>
            </UniformGrid>
            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Fechar" Style="{StaticResource LinkSuave}" Click="Fechar_Click" />
                <Button x:Name="BotaoCopiar" Content="Copiar mensagem" Style="{StaticResource BotaoLink}" HorizontalAlignment="Left" Click="Copiar_Click" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
