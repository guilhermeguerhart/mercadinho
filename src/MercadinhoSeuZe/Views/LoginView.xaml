<UserControl x:Class="MercadinhoSeuZe.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Button Content="← Voltar" Style="{StaticResource BotaoSecundario}" Padding="14,6"
                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="32,28" Click="Voltar_Click" />

        <Border Style="{StaticResource Cartao}" Width="400" Padding="32"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <Border Style="{StaticResource Etiqueta}">
                    <TextBlock Text="Mercadinho Seu Zé" FontWeight="Bold" />
                </Border>
                <TextBlock Text="Entrar no sistema" FontSize="24" FontWeight="Bold" Margin="0,18,0,4" />
                <TextBlock Text="Use o e-mail e a senha cadastrados pelo dono do mercado."
                           Foreground="{StaticResource TextoSuave}" FontSize="14" Margin="0,0,0,22" />

                <TextBlock Text="E-mail" Style="{StaticResource Rotulo}" />
                <TextBox x:Name="CampoEmail" Margin="0,0,0,16" />

                <TextBlock Text="Senha" Style="{StaticResource Rotulo}" />
                <PasswordBox x:Name="CampoSenha" Margin="0,0,0,8" />

                <TextBlock x:Name="Mensagem" Foreground="{StaticResource Erro}" FontSize="13"
                           Margin="0,6,0,0" Visibility="Collapsed" />

                <Button x:Name="BotaoEntrar" Content="Entrar" Style="{StaticResource BotaoPrincipal}"
                        Margin="0,18,0,0" IsDefault="True" Click="Entrar_Click" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
