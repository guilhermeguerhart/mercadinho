<UserControl x:Class="MercadinhoSeuZe.Views.AutorizacaoJanela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="420">
    <!-- Autorização do gerente no caixa (cancelar item, cancelar venda, desconto) -->
    <Border Style="{StaticResource Janela}" Padding="24,24,24,20">
        <StackPanel>
            <Border Width="48" Height="48" CornerRadius="4" Background="{StaticResource EtiquetaClara}" HorizontalAlignment="Center" Margin="0,0,0,12">
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCadeado}" Foreground="{StaticResource Ambar700}" Width="22" />
            </Border>
            <TextBlock Text="Autorização do gerente" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6" />
            <TextBlock x:Name="Texto" Style="{StaticResource TextoSuave}" FontSize="14" TextAlignment="Center" Margin="0,0,0,16" />

            <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="{StaticResource Vermelho600}" Visibility="Collapsed">
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </Border>

            <TextBlock Text="Usuário do gerente" Style="{StaticResource Rotulo}" />
            <TextBox x:Name="Usuario" MaxLength="100" AutomationProperties.Name="Usuário do gerente" />
            <TextBlock Text="Senha" Style="{StaticResource Rotulo}" Margin="0,14,0,6" />
            <PasswordBox x:Name="Senha" MaxLength="72" AutomationProperties.Name="Senha do gerente" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Voltar" Style="{StaticResource BotaoFantasma}" Margin="0,0,10,0" Click="Voltar_Click" />
                <Button x:Name="BotaoAutorizar" Content="Autorizar" Style="{StaticResource BotaoPrimario}" IsDefault="True" Click="Autorizar_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
