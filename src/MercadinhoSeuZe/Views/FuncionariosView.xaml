<UserControl x:Class="MercadinhoSeuZe.Views.FuncionariosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <!-- Funcionários (só o gerente): quem usa o sistema, a função de cada um, cadastrar, editar, redefinir senha e remover -->
    <StackPanel>
        <DockPanel Margin="0,0,0,28">
            <Button DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Bottom"
                    AutomationProperties.Name="Novo funcionário" Click="Novo_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeMais}" Foreground="White" Width="18" Margin="0,0,8,0" />
                    <TextBlock Text="Novo funcionário" />
                </StackPanel>
            </Button>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Funcionários" FontSize="28" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="Resumo" Text="Carregando…" Style="{StaticResource TextoSuave}" />
            </StackPanel>
        </DockPanel>

        <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="{StaticResource Vermelho600}"
                Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tentar de novo" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Vermelho600}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="TentarDeNovo_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- Pedidos de "esqueci minha senha" feitos na tela de login -->
        <Border x:Name="AvisoSenhas" Style="{StaticResource Aviso}" Background="{StaticResource Ambar50}" BorderBrush="{StaticResource Ambar700}"
                Margin="0,0,0,20" Visibility="Collapsed">
            <DockPanel>
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCadeado}" Foreground="{StaticResource Ambar700}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoSenhasTexto" Foreground="{StaticResource Ambar700}" FontSize="14" />
            </DockPanel>
        </Border>

        <Border Style="{StaticResource CartaoBorda}" Padding="24,22">
            <StackPanel>
                <Grid Margin="0,0,0,12">
                    <TextBox x:Name="Busca" Padding="42,0,14,0" MaxLength="60" TextChanged="Busca_TextChanged"
                             AutomationProperties.Name="Buscar funcionário por nome ou usuário" />
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeBusca}" Foreground="{StaticResource Suave}"
                                    Width="18" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="DicaBusca" Text="Buscar por nome ou usuário..." Foreground="{StaticResource Placeholder}" FontSize="15"
                               VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False" />
                </Grid>
                <WrapPanel x:Name="Chips" Margin="0,0,0,8" />

                <Grid x:Name="CabecalhoTabela" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="290" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="FUNCIONÁRIO" Style="{StaticResource Cabecalho}" />
                    <TextBlock Grid.Column="1" Text="FUNÇÃO" Style="{StaticResource Cabecalho}" />
                    <TextBlock Grid.Column="2" Text="ÚLTIMO ACESSO" Style="{StaticResource Cabecalho}" />
                </Grid>
                <Border Height="2" Background="{StaticResource Tinta}" Margin="0,8,0,0" />
                <StackPanel x:Name="Lista" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
