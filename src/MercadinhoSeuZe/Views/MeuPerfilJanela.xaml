<UserControl x:Class="MercadinhoSeuZe.Views.MeuPerfilJanela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="480">
    <!-- Meu perfil (todos os usuários): dados de quem está logado e troca da própria senha -->
    <Border Style="{StaticResource Janela}" Padding="24,24,24,20">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource LinkSuave}" FontSize="24" FontWeight="Normal"
                        VerticalAlignment="Top" Click="Fechar_Click" ToolTip="Fechar" AutomationProperties.Name="Fechar" />
                <TextBlock Text="Meu perfil" FontSize="22" FontWeight="Bold" />
            </DockPanel>

            <!-- Crachá -->
            <Border Background="{StaticResource PapelClaro}" BorderBrush="{StaticResource Linha}" BorderThickness="1" CornerRadius="8" Padding="18,16">
                <DockPanel>
                    <Border Width="56" Height="56" CornerRadius="6" Background="{StaticResource Etiqueta}" Margin="0,0,16,0"
                            Effect="{StaticResource SombraEtiqueta}" VerticalAlignment="Top">
                        <TextBlock x:Name="Avatar" FontSize="26" FontWeight="ExtraBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="Nome" FontSize="19" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Border x:Name="Funcao" Style="{StaticResource Pilula}" Padding="8,2">
                                <TextBlock x:Name="FuncaoTexto" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Verde700}" />
                            </Border>
                            <TextBlock x:Name="Usuario" Style="{StaticResource TextoSuave}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <WrapPanel x:Name="Detalhes" Margin="0,14,0,0" />

            <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Margin="0,8,0,14" />
            <TextBlock Text="Trocar minha senha" FontSize="16" FontWeight="Bold" />
            <TextBlock Style="{StaticResource TextoSuave}" FontSize="13" Margin="0,2,0,12"
                       Text="Use pelo menos 8 caracteres. Se esquecer, o gerente redefine na tela Funcionários." />

            <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="{StaticResource Vermelho600}" Visibility="Collapsed">
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </Border>

            <TextBlock Text="Senha atual" Style="{StaticResource Rotulo}" />
            <PasswordBox x:Name="SenhaAtual" MaxLength="72" AutomationProperties.Name="Senha atual" />
            <TextBlock x:Name="SenhaAtualErro" Style="{StaticResource ErroCampo}" />

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Nova senha" Style="{StaticResource Rotulo}" />
                    <PasswordBox x:Name="SenhaNova" MaxLength="72" AutomationProperties.Name="Nova senha" />
                    <TextBlock x:Name="SenhaNovaErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Repita a nova senha" Style="{StaticResource Rotulo}" />
                    <PasswordBox x:Name="SenhaRepetida" MaxLength="72" AutomationProperties.Name="Repita a nova senha" />
                    <TextBlock x:Name="SenhaRepetidaErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Fechar" Style="{StaticResource BotaoFantasma}" Margin="0,0,10,0" Click="Fechar_Click" />
                <Button x:Name="BotaoSalvar" Content="Trocar senha" Style="{StaticResource BotaoPrimario}" IsDefault="True" Click="TrocarSenha_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
