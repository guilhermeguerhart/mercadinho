<UserControl x:Class="MercadinhoSeuZe.Views.AreaUsuarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="48,32" MaxWidth="980">
            <DockPanel>
                <Border Style="{StaticResource Etiqueta}" DockPanel.Dock="Left">
                    <TextBlock Text="Mercadinho Seu Zé" FontWeight="Bold" FontSize="17" />
                </Border>
                <Button Content="Sair" Style="{StaticResource BotaoSecundario}" Padding="18,7"
                        HorizontalAlignment="Right" Click="Sair_Click" />
            </DockPanel>

            <TextBlock x:Name="Saudacao" Style="{StaticResource Titulo}" FontSize="28" Margin="0,40,0,6" />
            <TextBlock x:Name="DescricaoPerfil" Foreground="{StaticResource TextoSuave}" Margin="0,0,0,28" />

            <!-- Módulos liberados para o perfil; preenchido no código -->
            <ItemsControl x:Name="Modulos">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Cartao}" Width="290" Margin="0,0,14,14">
                            <StackPanel>
                                <TextBlock Text="{Binding Nome}" FontWeight="Bold" FontSize="18" />
                                <TextBlock Text="{Binding Descricao}" Foreground="{StaticResource TextoSuave}"
                                           FontSize="14" Margin="0,6,0,14" />
                                <TextBlock Text="{Binding Previsao}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#8A5A00" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
