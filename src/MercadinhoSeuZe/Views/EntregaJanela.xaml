<UserControl x:Class="MercadinhoSeuZe.Views.EntregaJanela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="760">
    <!-- Registrar a entrega de um pedido: confere o que chegou (ou importa o XML da nota) e cria os lotes no estoque -->
    <Border Style="{StaticResource CartaoBorda}" CornerRadius="16" Padding="24,24,24,20" Effect="{StaticResource SombraJanela}">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource LinkSuave}" FontSize="24" FontWeight="Normal"
                        VerticalAlignment="Top" Click="Cancelar_Click" ToolTip="Fechar" AutomationProperties.Name="Fechar" />
                <StackPanel>
                    <TextBlock Text="Registrar entrega" FontSize="22" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock x:Name="Subtitulo" FontSize="14" Style="{StaticResource TextoSuave}" />
                </StackPanel>
            </DockPanel>

            <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="#F2C4BE" Visibility="Collapsed">
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </Border>

            <!-- Resultado da importação do XML da nota -->
            <Border x:Name="AvisoNota" Style="{StaticResource Aviso}" Background="{StaticResource Verde50}" BorderBrush="#BFE0CB" Visibility="Collapsed">
                <DockPanel>
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeFechamento}" Foreground="{StaticResource Verde700}"
                                    Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock x:Name="AvisoNotaTexto" Foreground="{StaticResource Verde700}" FontSize="14" />
                </DockPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Data da entrega" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="DataEntrega" MaxLength="10" AutomationProperties.Name="Data da entrega" ToolTip="dd/mm/aaaa" />
                    <TextBlock x:Name="DataEntregaErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
                <StackPanel x:Name="CampoNota" Grid.Column="2">
                    <TextBlock Text="Nº da nota fiscal" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="NumeroNota" MaxLength="20" AutomationProperties.Name="Número da nota fiscal" />
                </StackPanel>
                <Button x:Name="BotaoXml" Grid.Column="4" Style="{StaticResource BotaoFantasma}" VerticalAlignment="Top" Margin="0,26,0,0"
                        HorizontalAlignment="Left" Click="ImportarXml_Click" AutomationProperties.Name="Importar XML da nota fiscal"
                        ToolTip="Arquivo .xml da NF-e que o fornecedor manda por e-mail">
                    <StackPanel Orientation="Horizontal">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeFechamento}" Foreground="{StaticResource Verde700}" Width="17" Margin="0,0,8,0" />
                        <TextBlock Text="Importar XML da nota" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock FontSize="12" Style="{StaticResource TextoSuave}" Margin="0,6,0,0"
                       Text="A data vira a data de compra dos lotes. Confira o que chegou de cada produto (0 = não veio), o custo e a validade na embalagem, ou importe o XML da nota para preencher sozinho." />

            <!-- Cabeçalho dos itens -->
            <Grid x:Name="Cabecalho" Margin="0,18,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Produto" Style="{StaticResource Cabecalho}" />
                <TextBlock Grid.Column="1" Text="Chegou" Style="{StaticResource Cabecalho}" />
                <TextBlock x:Name="CabecalhoCusto" Grid.Column="3" Text="Custo (R$)" Style="{StaticResource Cabecalho}" />
                <TextBlock Grid.Column="5" Text="Validade" Style="{StaticResource Cabecalho}" />
            </Grid>
            <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0">
                <StackPanel x:Name="Itens" />
            </Border>
            <TextBlock x:Name="Total" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" Margin="0,8,0,0" />

            <!-- O que faltou -->
            <Border x:Name="CampoResto" Background="{StaticResource Fundo}" CornerRadius="10" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
                <StackPanel>
                    <CheckBox x:Name="RestoPendente" IsChecked="True" Content="O que faltou continua pendente (vira um pedido novo para o mesmo fornecedor)" />
                    <StackPanel x:Name="CampoPrevisaoResto" Orientation="Horizontal" Margin="22,8,0,0">
                        <TextBlock Text="Previsão do que faltou" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" />
                        <StackPanel>
                            <TextBox x:Name="PrevisaoResto" MaxLength="10" Width="140" AutomationProperties.Name="Previsão do que faltou" ToolTip="dd/mm/aaaa" />
                            <TextBlock x:Name="PrevisaoRestoErro" Style="{StaticResource ErroCampo}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,10,0" Click="Cancelar_Click" />
                <Button x:Name="BotaoSalvar" Content="Registrar entrega" Style="{StaticResource BotaoPrimario}" IsDefault="True" Click="Salvar_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
