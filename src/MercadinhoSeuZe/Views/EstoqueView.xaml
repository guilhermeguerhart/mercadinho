<UserControl x:Class="MercadinhoSeuZe.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">

    <StackPanel>
        <!-- Cabeçalho -->
        <DockPanel Margin="0,0,0,28">
            <Button x:Name="BotaoNovo" DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Bottom"
                    AutomationProperties.Name="Novo produto" Click="NovoProduto_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeMais}" Foreground="White" Width="18" Margin="0,0,8,0" />
                    <TextBlock Text="Novo produto" />
                </StackPanel>
            </Button>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Produtos em estoque" FontSize="28" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="Resumo" Text="Carregando…" Style="{StaticResource TextoSuave}" />
            </StackPanel>
        </DockPanel>

        <!-- Erro ao ler o banco -->
        <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="#F2C4BE"
                Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tentar de novo" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Vermelho600}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="TentarDeNovo_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- Entrada de mercadoria pelo leitor de código de barras -->
        <Border Style="{StaticResource CartaoBorda}" Padding="22,18" Margin="0,0,0,16">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{StaticResource Verde50}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCodigoBarras}" Foreground="{StaticResource Verde700}" Width="22" />
                </Border>
                <StackPanel x:Name="TextoLeitor" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Chegou mercadoria?" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Passe o leitor no código de barras da caixa para dar entrada no lote." FontSize="13" Style="{StaticResource TextoSuave}" />
                </StackPanel>
                <Grid x:Name="CaixaLeitor" VerticalAlignment="Center" Width="360" HorizontalAlignment="Right">
                    <TextBox x:Name="Leitor" MaxLength="40" Padding="42,0,14,0" KeyDown="Leitor_KeyDown" TextChanged="Leitor_TextChanged"
                             AutomationProperties.Name="Código de barras da caixa" />
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCodigoBarras}" Foreground="{StaticResource Suave}"
                                    Width="18" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="DicaLeitor" Text="Código de barras da caixa" Foreground="{StaticResource Placeholder}" FontSize="15"
                               VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Indicadores quadrados numa fileira só (clicar filtra a lista; passar o mouse explica) -->
        <UniformGrid x:Name="Kpis" Rows="1" Columns="5" HorizontalAlignment="Left" Margin="0,0,0,20">
            <Button Style="{StaticResource Kpi}" Uid="todos" Click="Filtro_Click" AutomationProperties.Name="Mostrar todos os produtos">
                <Button.ToolTip><TextBlock x:Name="KpiTotalSub" Text="Cadastrados no estoque" /></Button.ToolTip>
                <StackPanel>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Verde50}" HorizontalAlignment="Left">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCaixaProduto}" Foreground="{StaticResource Verde700}" Width="15" />
                    </Border>
                    <TextBlock x:Name="KpiTotal" Style="{StaticResource KpiValor}" />
                    <TextBlock Text="Produtos" Style="{StaticResource KpiRotulo}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Uid="baixo" Click="Filtro_Click" AutomationProperties.Name="Filtrar estoque baixo">
                <Button.ToolTip><TextBlock x:Name="KpiBaixoSub" Text="Abaixo do mínimo cadastrado" /></Button.ToolTip>
                <StackPanel>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Ambar50}" HorizontalAlignment="Left">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeRelogio}" Foreground="{StaticResource Ambar700}" Width="16" />
                    </Border>
                    <TextBlock x:Name="KpiBaixo" Style="{StaticResource KpiValor}" />
                    <TextBlock Text="Estoque baixo" Style="{StaticResource KpiRotulo}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Uid="sem" Click="Filtro_Click" AutomationProperties.Name="Filtrar sem estoque">
                <Button.ToolTip><TextBlock Text="Nenhuma unidade disponível" /></Button.ToolTip>
                <StackPanel>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Vermelho50}" HorizontalAlignment="Left">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}" Width="16" />
                    </Border>
                    <TextBlock x:Name="KpiSem" Style="{StaticResource KpiValor}" />
                    <TextBlock Text="Sem estoque" Style="{StaticResource KpiRotulo}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Uid="validade" Click="Filtro_Click" AutomationProperties.Name="Filtrar validade próxima">
                <Button.ToolTip><TextBlock Text="Ainda não venceu, mas vence em até 30 dias" /></Button.ToolTip>
                <StackPanel>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Ambar50}" HorizontalAlignment="Left">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Ambar700}" Width="16" />
                    </Border>
                    <TextBlock x:Name="KpiValidade" Style="{StaticResource KpiValor}" />
                    <TextBlock Text="Validade próxima" Style="{StaticResource KpiRotulo}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Uid="vencido" Click="Filtro_Click" AutomationProperties.Name="Filtrar vencidos">
                <Button.ToolTip><TextBlock Text="Tem lote com a validade já passada" /></Button.ToolTip>
                <StackPanel>
                    <Border Width="26" Height="26" CornerRadius="7" Background="{StaticResource Vermelho50}" HorizontalAlignment="Left">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Vermelho600}" Width="16" />
                    </Border>
                    <TextBlock x:Name="KpiVencido" Style="{StaticResource KpiValor}" />
                    <TextBlock Text="Vencidos" Style="{StaticResource KpiRotulo}" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Lista -->
        <Border Style="{StaticResource CartaoBorda}" Padding="24,22">
            <StackPanel>
                <!-- Busca + botão da janela de filtros -->
                <DockPanel Margin="0,0,0,10">
                    <Button x:Name="BotaoFiltros" DockPanel.Dock="Right" Style="{StaticResource BotaoFantasma}" Margin="12,0,0,0"
                            Padding="16,0" Click="AbrirFiltros_Click" AutomationProperties.Name="Abrir filtros">
                        <StackPanel Orientation="Horizontal">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeFiltro}" Foreground="{StaticResource Verde700}" Width="18" Margin="0,0,8,0" />
                            <TextBlock Text="Filtros" VerticalAlignment="Center" />
                            <Border x:Name="ContadorFiltros" Background="{StaticResource Verde600}" CornerRadius="10" MinWidth="20" Height="20"
                                    Padding="6,0" Margin="8,0,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="ContadorFiltrosTexto" Foreground="White" FontSize="12" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Grid>
                        <TextBox x:Name="Busca" Padding="42,0,14,0" MaxLength="80" TextChanged="Busca_TextChanged"
                                 AutomationProperties.Name="Buscar produto, categoria ou código" />
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeBusca}" Foreground="{StaticResource Suave}"
                                        Width="18" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                        <TextBlock x:Name="DicaBusca" Text="Buscar produto, categoria ou código..." Foreground="{StaticResource Placeholder}" FontSize="15"
                                   VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False" />
                    </Grid>
                </DockPanel>

                <!-- Filtros em uso (clicar no × tira o filtro) e quantos produtos aparecem -->
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="LimparFiltros" DockPanel.Dock="Right" Content="Limpar filtros" Style="{StaticResource BotaoLink}"
                            VerticalAlignment="Center" Margin="12,0,0,8" Visibility="Collapsed" Click="LimparFiltros_Click" />
                    <WrapPanel x:Name="FiltrosAtivos">
                        <TextBlock x:Name="Mostrando" Style="{StaticResource TextoSuave}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,8" />
                    </WrapPanel>
                </DockPanel>

                <!-- Cabeçalho da tabela -->
                <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid x:Name="CabecalhoTabela">
                        <TextBlock Grid.Column="0" Text="Produto" Style="{StaticResource Cabecalho}" />
                        <TextBlock Grid.Column="1" Text="Categoria" Style="{StaticResource Cabecalho}" />
                        <TextBlock Grid.Column="2" Text="Qtd" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="3" Text="Preço" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" Margin="0,0,8,0" />
                    </Grid>
                </Border>

                <StackPanel x:Name="Lista" />
                <TextBlock x:Name="Vazio" Style="{StaticResource TextoSuave}" FontSize="15" HorizontalAlignment="Center"
                           Margin="0,28,0,20" Visibility="Collapsed" />

                <WrapPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Vermelho600}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="estoque abaixo do mínimo ou zerado" FontSize="13" Style="{StaticResource TextoSuave}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Ambar700}" Width="15" Margin="0,0,6,0" />
                        <TextBlock Text="aviso antecipado: chegando no mínimo, hora de pedir" FontSize="13" Style="{StaticResource TextoSuave}" />
                    </StackPanel>
                    <TextBlock Text="Clique na seta (à direita) para ver os lotes, a validade e editar o produto. Passe o mouse nos símbolos para ver a explicação."
                               FontSize="13" Style="{StaticResource TextoSuave}" Margin="0,0,0,4" />
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
