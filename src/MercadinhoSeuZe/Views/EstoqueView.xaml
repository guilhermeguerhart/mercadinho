<UserControl x:Class="MercadinhoSeuZe.Views.EstoqueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <UserControl.Resources>
        <!-- Indicador clicável: filtra a lista (mesmo visual do .kpi do painel) -->
        <Style x:Key="Kpi" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,16,16" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{StaticResource Cartao}" BorderBrush="{StaticResource Linha}"
                                BorderThickness="1" CornerRadius="12" Padding="22,20">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Verde600}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Verde600}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="KpiRotulo" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KpiValor" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,4" />
            <Setter Property="Text" Value="—" />
        </Style>
        <Style x:Key="KpiSub" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
            <Setter Property="FontSize" Value="13" />
        </Style>

        <!-- Filtro (igual a .chip do site); Tag="ativo" marca o selecionado -->
        <Style x:Key="Chip" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Suave}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="White" BorderBrush="{StaticResource Linha}" BorderThickness="1"
                                CornerRadius="17" Padding="14,6">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Verde600}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource Verde50}" />
                                <Setter TargetName="Borda" Property="BorderBrush" Value="{StaticResource Verde600}" />
                                <Setter Property="Foreground" Value="{StaticResource Verde700}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Cabecalho" TargetType="TextBlock" BasedOn="{StaticResource TextoSuave}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Cabeçalho -->
        <DockPanel Margin="0,0,0,28">
            <Button x:Name="BotaoNovo" DockPanel.Dock="Right" Style="{StaticResource BotaoPrimario}" VerticalAlignment="Bottom"
                    AutomationProperties.Name="Novo produto" Click="NovoProduto_Click">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeMais}" Foreground="White" Width="18" Margin="0,0,8,0" />
                    <TextBlock Text="Novo produto" />
                </StackPanel>
            </Button>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Produtos em estoque" FontSize="28" FontWeight="Bold" Margin="0,0,0,4" />
                <TextBlock x:Name="Resumo" Text="Carregando…" Style="{StaticResource TextoSuave}" />
            </StackPanel>
        </DockPanel>

        <!-- Erro ao ler o banco -->
        <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="#F2C4BE"
                Margin="0,0,0,24" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Tentar de novo" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Vermelho600}"
                        VerticalAlignment="Center" Margin="16,0,0,0" Click="TentarDeNovo_Click" />
                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}"
                                Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </DockPanel>
        </Border>

        <!-- Entrada de mercadoria pelo leitor de código de barras -->
        <Border Style="{StaticResource CartaoBorda}" Padding="22,18" Margin="0,0,0,16">
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="44" Height="44" CornerRadius="10" Background="{StaticResource Verde50}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCodigoBarras}" Foreground="{StaticResource Verde700}" Width="22" />
                </Border>
                <StackPanel x:Name="TextoLeitor" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="Chegou mercadoria?" FontSize="16" FontWeight="Bold" />
                    <TextBlock Text="Passe o leitor no código de barras da caixa para dar entrada no lote." FontSize="13" Style="{StaticResource TextoSuave}" />
                </StackPanel>
                <Grid x:Name="CaixaLeitor" VerticalAlignment="Center" Width="360" HorizontalAlignment="Right">
                    <TextBox x:Name="Leitor" MaxLength="40" Padding="42,0,14,0" KeyDown="Leitor_KeyDown" TextChanged="Leitor_TextChanged"
                             AutomationProperties.Name="Código de barras da caixa" />
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCodigoBarras}" Foreground="{StaticResource Suave}"
                                    Width="18" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="DicaLeitor" Text="Código de barras da caixa" Foreground="{StaticResource Placeholder}" FontSize="15"
                               VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- Indicadores (clicar filtra a lista) -->
        <UniformGrid x:Name="Kpis" Columns="4" Margin="0,0,-16,4">
            <Button Style="{StaticResource Kpi}" Uid="todos" Click="Filtro_Click" AutomationProperties.Name="Mostrar todos os produtos">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="9" Background="{StaticResource Verde50}">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCaixaProduto}" Foreground="{StaticResource Verde700}" Width="18" />
                        </Border>
                        <TextBlock Text="Produtos" Style="{StaticResource KpiRotulo}" />
                    </DockPanel>
                    <TextBlock x:Name="KpiTotal" Style="{StaticResource KpiValor}" />
                    <TextBlock x:Name="KpiTotalSub" Text="Cadastrados no estoque" Style="{StaticResource KpiSub}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Uid="baixo" Click="Filtro_Click" AutomationProperties.Name="Filtrar estoque baixo">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="9" Background="{StaticResource Ambar50}">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Ambar700}" Width="18" />
                        </Border>
                        <TextBlock Text="Estoque baixo" Style="{StaticResource KpiRotulo}" />
                    </DockPanel>
                    <TextBlock x:Name="KpiBaixo" Style="{StaticResource KpiValor}" />
                    <TextBlock x:Name="KpiBaixoSub" Text="Abaixo do mínimo cadastrado" Style="{StaticResource KpiSub}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Uid="sem" Click="Filtro_Click" AutomationProperties.Name="Filtrar sem estoque">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="9" Background="{StaticResource Vermelho50}">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeAlerta}" Foreground="{StaticResource Vermelho600}" Width="18" />
                        </Border>
                        <TextBlock Text="Sem estoque" Style="{StaticResource KpiRotulo}" />
                    </DockPanel>
                    <TextBlock x:Name="KpiSem" Style="{StaticResource KpiValor}" />
                    <TextBlock Text="Nenhuma unidade disponível" Style="{StaticResource KpiSub}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Kpi}" Uid="validade" Click="Filtro_Click" AutomationProperties.Name="Filtrar validade próxima">
                <StackPanel>
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="36" Height="36" CornerRadius="9" Background="{StaticResource Ambar50}">
                            <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeRelogio}" Foreground="{StaticResource Ambar700}" Width="18" />
                        </Border>
                        <TextBlock Text="Validade próxima" Style="{StaticResource KpiRotulo}" />
                    </DockPanel>
                    <TextBlock x:Name="KpiValidade" Style="{StaticResource KpiValor}" />
                    <TextBlock Text="Vencidos ou vencem em até 30 dias" Style="{StaticResource KpiSub}" />
                </StackPanel>
            </Button>
        </UniformGrid>

        <!-- Lista -->
        <Border Style="{StaticResource CartaoBorda}" Padding="24,22">
            <StackPanel>
                <!-- Busca -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="440" />
                        <ColumnDefinition Width="0.01*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Busca" Padding="42,0,14,0" MaxLength="80" TextChanged="Busca_TextChanged"
                             AutomationProperties.Name="Buscar produto ou categoria" />
                    <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeBusca}" Foreground="{StaticResource Suave}"
                                    Width="18" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False" />
                    <TextBlock x:Name="DicaBusca" Text="Buscar produto ou categoria..." Foreground="{StaticResource Placeholder}" FontSize="15"
                               VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False" />
                </Grid>

                <!-- Filtros e ordem -->
                <WrapPanel x:Name="Filtros" Margin="0,0,0,2">
                    <Button Style="{StaticResource Chip}" Tag="ativo" Uid="todos" Click="Filtro_Click">
                        <TextBlock><Run Text="Todos " /><Run x:Name="ContTodos" FontWeight="Bold" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource Chip}" Uid="baixo" Click="Filtro_Click">
                        <TextBlock><Run Text="Estoque baixo " /><Run x:Name="ContBaixo" FontWeight="Bold" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource Chip}" Uid="aviso" Click="Filtro_Click">
                        <TextBlock><Run Text="Repor em breve " /><Run x:Name="ContAviso" FontWeight="Bold" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource Chip}" Uid="sem" Click="Filtro_Click">
                        <TextBlock><Run Text="Sem estoque " /><Run x:Name="ContSem" FontWeight="Bold" /></TextBlock>
                    </Button>
                    <Button Style="{StaticResource Chip}" Uid="validade" Click="Filtro_Click">
                        <TextBlock><Run Text="Validade próxima " /><Run x:Name="ContValidade" FontWeight="Bold" /></TextBlock>
                    </Button>
                </WrapPanel>
                <WrapPanel x:Name="Ordens" Margin="0,0,0,10">
                    <TextBlock Text="Ordenar por" Style="{StaticResource TextoSuave}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,8" />
                    <Button Style="{StaticResource Chip}" Tag="ativo" Uid="nome" Content="Nome (A–Z)" Click="Ordem_Click" />
                    <Button Style="{StaticResource Chip}" Uid="validade" Content="Validade mais próxima" Click="Ordem_Click" />
                    <Button Style="{StaticResource Chip}" Uid="quantidade" Content="Menor quantidade" Click="Ordem_Click" />
                </WrapPanel>

                <!-- Cabeçalho da tabela -->
                <Border BorderBrush="{StaticResource Linha}" BorderThickness="0,0,0,1" Padding="0,8">
                    <Grid x:Name="CabecalhoTabela">
                        <TextBlock Grid.Column="1" Text="Produto" Style="{StaticResource Cabecalho}" />
                        <TextBlock Grid.Column="2" Text="Categoria" Style="{StaticResource Cabecalho}" />
                        <TextBlock Grid.Column="3" Text="Qtd" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="4" Text="Próx. validade" Style="{StaticResource Cabecalho}" Margin="20,0,0,0" />
                        <TextBlock Grid.Column="5" Text="Preço" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" />
                        <TextBlock Grid.Column="6" Text="Ações" Style="{StaticResource Cabecalho}" HorizontalAlignment="Right" />
                    </Grid>
                </Border>

                <StackPanel x:Name="Lista" />
                <TextBlock x:Name="Vazio" Style="{StaticResource TextoSuave}" FontSize="15" HorizontalAlignment="Center"
                           Margin="0,28,0,20" Visibility="Collapsed" />

                <WrapPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,24,4">
                        <Ellipse Width="8" Height="8" Fill="{StaticResource Vermelho600}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="estoque abaixo do mínimo ou zerado" FontSize="13" Style="{StaticResource TextoSuave}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Ambar700}" Width="15" Margin="0,0,6,0" />
                        <TextBlock Text="aviso antecipado: chegando no mínimo, hora de pedir (passe o mouse para ver)" FontSize="13" Style="{StaticResource TextoSuave}" />
                    </StackPanel>
                </WrapPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
