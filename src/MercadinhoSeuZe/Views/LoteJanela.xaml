<UserControl x:Class="MercadinhoSeuZe.Views.LoteJanela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540">
    <!-- Novo lote / edição de lote de um produto -->
    <Border Style="{StaticResource CartaoBorda}" CornerRadius="16" Padding="24,24,24,20" Effect="{StaticResource SombraJanela}">
        <StackPanel>
            <DockPanel Margin="0,0,0,18">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource LinkSuave}" FontSize="24" FontWeight="Normal"
                        VerticalAlignment="Top" Click="Cancelar_Click" ToolTip="Fechar" AutomationProperties.Name="Fechar" />
                <StackPanel>
                    <TextBlock x:Name="Titulo" Text="Novo lote" FontSize="22" FontWeight="Bold" Margin="0,0,0,2" />
                    <TextBlock x:Name="Subtitulo" FontSize="14" Style="{StaticResource TextoSuave}" />
                </StackPanel>
            </DockPanel>

            <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="#F2C4BE" Visibility="Collapsed">
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </Border>

            <!-- Produto com pedido pendente: sugere registrar a entrega do pedido -->
            <Border x:Name="AvisoPedido" Style="{StaticResource Aviso}" Background="{StaticResource Azul50}" BorderBrush="#C9DCF1" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeCaminhao}" Foreground="{StaticResource Azul600}"
                                        Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock x:Name="AvisoPedidoTexto" Foreground="{StaticResource Azul600}" FontSize="14" />
                    </DockPanel>
                    <Button x:Name="BotaoEntregaPedido" Content="Registrar a entrega do pedido" Style="{StaticResource BotaoLink}" Foreground="{StaticResource Azul600}"
                            HorizontalAlignment="Left" Margin="28,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Entrada pelo código de barras: caixas x unidades por caixa -->
            <Border x:Name="CampoCaixas" Background="{StaticResource Verde50}" CornerRadius="10" Padding="16,12" Margin="0,0,0,16" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="CaixaLida" FontSize="13" Foreground="{StaticResource Verde700}" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <DockPanel>
                        <TextBlock x:Name="UnidadesPorCaixaTexto" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="15" />
                        <TextBlock Text="Caixas recebidas" Style="{StaticResource Rotulo}" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <TextBox x:Name="Caixas" MaxLength="4" Width="90" HorizontalAlignment="Left" AutomationProperties.Name="Caixas recebidas" />
                    </DockPanel>
                    <TextBlock x:Name="CaixasErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RotuloInicial" Text="Quantidade comprada" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="Inicial" MaxLength="10" AutomationProperties.Name="Quantidade comprada" />
                    <TextBlock x:Name="InicialErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
                <StackPanel x:Name="CampoRestante" Grid.Column="2">
                    <TextBlock x:Name="RotuloRestante" Text="Quantidade restante" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="Restante" MaxLength="10" AutomationProperties.Name="Quantidade restante" />
                    <TextBlock x:Name="RestanteErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Data de compra" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="Compra" MaxLength="10" AutomationProperties.Name="Data de compra" ToolTip="dd/mm/aaaa" />
                    <TextBlock x:Name="CompraErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Validade" Style="{StaticResource Rotulo}" />
                    <TextBox x:Name="Validade" MaxLength="10" AutomationProperties.Name="Validade" ToolTip="dd/mm/aaaa (deixe vazio se não vence)" />
                    <TextBlock x:Name="ValidadeErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="DicaValidade" FontSize="12" Foreground="{StaticResource Verde700}" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                        <Style.Triggers>
                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Text="Datas no formato dd/mm/aaaa. Validade pode ficar vazia para produtos que não vencem." FontSize="12"
                       Style="{StaticResource TextoSuave}" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,10,0" Click="Cancelar_Click" />
                <Button x:Name="BotaoSalvar" Content="Adicionar lote" Style="{StaticResource BotaoPrimario}" IsDefault="True" Click="Salvar_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
