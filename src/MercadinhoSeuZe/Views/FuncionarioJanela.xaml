<UserControl x:Class="MercadinhoSeuZe.Views.FuncionarioJanela"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520">
    <!-- Novo funcionário, editar (nome e função) ou redefinir a senha -->
    <Border Style="{StaticResource Janela}" Padding="24,24,24,20">
        <StackPanel>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource LinkSuave}" FontSize="24" FontWeight="Normal"
                        VerticalAlignment="Top" Click="Cancelar_Click" ToolTip="Fechar" AutomationProperties.Name="Fechar" />
                <TextBlock x:Name="Titulo" Text="Novo funcionário" FontSize="22" FontWeight="Bold" />
            </DockPanel>
            <TextBlock x:Name="Explicacao" Style="{StaticResource TextoSuave}" FontSize="13" Margin="0,0,0,16" />

            <Border x:Name="AvisoErro" Style="{StaticResource Aviso}" Background="{StaticResource Vermelho50}" BorderBrush="{StaticResource Vermelho600}" Visibility="Collapsed">
                <TextBlock x:Name="AvisoErroTexto" Foreground="{StaticResource Vermelho600}" FontSize="14" />
            </Border>

            <StackPanel x:Name="CamposDados">
                <TextBlock Text="Nome" Style="{StaticResource Rotulo}" />
                <TextBox x:Name="Nome" MaxLength="60" AutomationProperties.Name="Nome do funcionário" />
                <TextBlock x:Name="NomeErro" Style="{StaticResource ErroCampo}" />

                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Usuário (para o login)" Style="{StaticResource Rotulo}" />
                        <TextBox x:Name="Usuario" MaxLength="40" AutomationProperties.Name="Usuário para o login" ToolTip="Ex.: ana.caixa (sem acento e sem espaço)" />
                        <TextBlock x:Name="UsuarioErro" Style="{StaticResource ErroCampo}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Função" Style="{StaticResource Rotulo}" />
                        <ComboBox x:Name="Funcao" AutomationProperties.Name="Função">
                            <ComboBoxItem Content="Operador de caixa" Tag="operador" />
                            <ComboBoxItem Content="Gerente" Tag="gerente" />
                        </ComboBox>
                        <TextBlock x:Name="FuncaoErro" Style="{StaticResource ErroCampo}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="DicaFuncao" FontSize="12" Style="{StaticResource TextoSuave}" Margin="0,8,0,0"
                           Text="Operador só usa o Caixa. Gerente vê tudo: Painel, Estoque, Fornecedores, Caixa e Funcionários." />
            </StackPanel>

            <Grid x:Name="CamposSenha" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="RotuloSenha" Text="Senha inicial" Style="{StaticResource Rotulo}" />
                    <PasswordBox x:Name="Senha" MaxLength="72" AutomationProperties.Name="Senha" />
                    <TextBlock x:Name="SenhaErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Repita a senha" Style="{StaticResource Rotulo}" />
                    <PasswordBox x:Name="SenhaRepetida" MaxLength="72" AutomationProperties.Name="Repita a senha" />
                    <TextBlock x:Name="SenhaRepetidaErro" Style="{StaticResource ErroCampo}" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Cancelar" Style="{StaticResource BotaoFantasma}" Margin="0,0,10,0" Click="Cancelar_Click" />
                <Button x:Name="BotaoSalvar" Content="Cadastrar funcionário" Style="{StaticResource BotaoPrimario}" IsDefault="True" Click="Salvar_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
