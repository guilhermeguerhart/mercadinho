<UserControl x:Class="MercadinhoSeuZe.Views.AreaInternaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <UserControl.Resources>
        <!-- Item do menu lateral (igual a .nav-item do site) -->
        <Style x:Key="ItemMenu" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource CremeSuave}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Sombra" Background="{StaticResource Verde800}" CornerRadius="4" Margin="2,2,-2,-2" Visibility="Collapsed" />
                            <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Foco" BorderBrush="{StaticResource Etiqueta}" BorderThickness="3" CornerRadius="4" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Borda" Property="Background" Value="#1AF4F6FA" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource Etiqueta}" />
                                <Setter TargetName="Sombra" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Foco" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topo no celular / janela estreita -->
        <Border x:Name="BarraCompacta" Grid.ColumnSpan="2" Background="{StaticResource Verde700}" Height="64" Padding="16,0" Visibility="Collapsed">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MarcaQuadrado}">
                        <TextBlock Text="M" Foreground="{StaticResource Tinta}" FontWeight="ExtraBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Mercado" FontWeight="ExtraBold" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Creme}" />
                </StackPanel>
                <Button Content="Menu" Style="{StaticResource BotaoFantasma}" Background="Transparent" BorderBrush="{StaticResource CremeSuave}" Foreground="{StaticResource Creme}" Height="38" Padding="14,0"
                        FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AlternarMenu_Click" />
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer x:Name="Rolagem" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto" SizeChanged="Rolagem_SizeChanged">
            <StackPanel x:Name="AreaConteudo" Margin="40,32,40,48">
                <!-- Modo simulação ligado (script 018): a loja vende, pede e recebe sozinha com dados de teste -->
                <Border x:Name="FaixaSimulacao" Visibility="Collapsed" Background="{StaticResource Etiqueta}" CornerRadius="4" Padding="14,8" Margin="0,0,0,16">
                    <DockPanel>
                        <Button x:Name="BotaoSimularAgora" DockPanel.Dock="Right" Content="Simular agora" Style="{StaticResource BotaoFantasma}" Height="30"
                                Padding="12,0" FontSize="13" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="SimularAgora_Click" />
                        <TextBlock x:Name="TextoSimulacao" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Tinta}"
                                   Text="Modo simulação: a loja está vendendo, pedindo e recebendo sozinha (dados de teste). Desligue antes de a loja usar o sistema de verdade." />
                    </DockPanel>
                </Border>
                <ContentControl x:Name="Pagina" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- Fundo escuro do menu aberto em janela estreita -->
        <Border x:Name="FundoMenu" Grid.Row="1" Grid.ColumnSpan="2" Background="#40000000" Visibility="Collapsed"
                MouseLeftButtonDown="FundoMenu_Click" />

        <!-- Menu lateral -->
        <Border x:Name="MenuLateral" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Width="264" HorizontalAlignment="Left"
                Background="{StaticResource Verde700}" Padding="14,0,14,20">
            <DockPanel>
                <!-- Toldo listrado no topo do menu -->
                <Border x:Name="ToldoMenu" DockPanel.Dock="Top" Height="19" Margin="-14,0,-14,14" Background="{StaticResource Toldo}" />
                <StackPanel x:Name="MarcaMenu" DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,10,22">
                    <Border Style="{StaticResource MarcaQuadrado}">
                        <TextBlock Text="M" Foreground="{StaticResource Tinta}" FontWeight="ExtraBold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Mercado" FontWeight="ExtraBold" FontSize="19" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Creme}" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="#33F4F6FA" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <!-- Usuário logado: clicar abre "Meu perfil" -->
                        <Button x:Name="BotaoPerfil" Style="{StaticResource ItemMenu}" Padding="8,6" ToolTip="Meu perfil" Click="MeuPerfil_Click"
                                AutomationProperties.Name="Meu perfil">
                            <DockPanel>
                                <ContentControl DockPanel.Dock="Right" Style="{StaticResource Icone}" Tag="{StaticResource IconeSetaDireita}" Width="14"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                                <Border Width="36" Height="36" CornerRadius="4" Background="{StaticResource Etiqueta}" Margin="0,0,10,0">
                                    <TextBlock x:Name="Avatar" Foreground="{StaticResource Tinta}" FontWeight="ExtraBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="NomeUsuario" FontSize="14" FontWeight="Bold" Foreground="White" />
                                    <TextBlock x:Name="PerfilUsuario" FontSize="12" FontWeight="Normal" Foreground="{StaticResource CremeSuave}" />
                                </StackPanel>
                            </DockPanel>
                        </Button>
                        <Button x:Name="BotaoSair" AutomationProperties.Name="Sair" Style="{StaticResource BotaoFantasma}" Background="Transparent" BorderBrush="#73F4F6FA" Foreground="{StaticResource Creme}" Height="38"
                                FontSize="14" Margin="0,10,0,0" Click="Sair_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeSair}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Margin="0,0,8,0" />
                                <TextBlock Text="Sair" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ItensMenu" />
            </DockPanel>
        </Border>

        <!-- Janela por cima da tela (cadastros e confirmações); Esc fecha -->
        <Grid x:Name="Sobreposicao" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed">
            <Border Background="#8C1F2633" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ContentControl x:Name="JanelaAtual" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16" />
            </ScrollViewer>
        </Grid>

        <!-- Aviso rápido (toast) -->
        <Border x:Name="Toast" Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Tinta}" CornerRadius="4" Padding="18,12" Effect="{StaticResource SombraToast}"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastTexto" Foreground="White" FontSize="14" />
        </Border>
    </Grid>
</UserControl>
