<UserControl x:Class="MercadinhoSeuZe.Views.AreaInternaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             SizeChanged="AoRedimensionar">
    <UserControl.Resources>
        <!-- Item do menu lateral (igual a .nav-item do site) -->
        <Style x:Key="ItemMenu" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Suave}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Borda" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="{x:Null}" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource Fundo}" />
                                <Setter Property="Foreground" Value="{StaticResource Tinta}" />
                            </MultiTrigger>
                            <Trigger Property="Tag" Value="ativo">
                                <Setter TargetName="Borda" Property="Background" Value="{StaticResource Verde50}" />
                                <Setter Property="Foreground" Value="{StaticResource Verde700}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ColunaMenu" Width="264" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Topo no celular / janela estreita -->
        <Border x:Name="BarraCompacta" Grid.ColumnSpan="2" Background="White" BorderBrush="{StaticResource Linha}"
                BorderThickness="0,0,0,1" Height="64" Padding="16,0" Visibility="Collapsed">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource MarcaQuadrado}">
                        <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Mercado" FontWeight="Bold" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <Button Content="Menu" Style="{StaticResource BotaoFantasma}" Foreground="{StaticResource Tinta}" Height="38" Padding="14,0"
                        FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AlternarMenu_Click" />
            </DockPanel>
        </Border>

        <!-- Conteúdo -->
        <ScrollViewer x:Name="Rolagem" Grid.Row="1" Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="AreaConteudo" Margin="40,32,40,48">
                <!-- Aviso de modo de teste -->
                <Border x:Name="AvisoTeste" Background="{StaticResource Ambar50}" BorderBrush="#F0DCA8" BorderThickness="1"
                        CornerRadius="8" Padding="14,10" Margin="0,0,0,24">
                    <DockPanel>
                        <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeTriangulo}" Foreground="{StaticResource Ambar700}"
                                        Width="18" VerticalAlignment="Top" Margin="0,1,10,0" />
                        <TextBlock Foreground="{StaticResource Ambar700}" FontSize="14">
                            <Run FontWeight="SemiBold" Text="Modo de teste da semana 2." />
                            Os números e avisos são dados de exemplo; nada é lido nem gravado no banco.
                        </TextBlock>
                    </DockPanel>
                </Border>
                <ContentControl x:Name="Pagina" Focusable="False" />
            </StackPanel>
        </ScrollViewer>

        <!-- Fundo escuro do menu aberto em janela estreita -->
        <Border x:Name="FundoMenu" Grid.Row="1" Grid.ColumnSpan="2" Background="#40000000" Visibility="Collapsed"
                MouseLeftButtonDown="FundoMenu_Click" />

        <!-- Menu lateral -->
        <Border x:Name="MenuLateral" Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Width="264" HorizontalAlignment="Left"
                Background="White" BorderBrush="{StaticResource Linha}" BorderThickness="0,0,1,0" Padding="14,20">
            <DockPanel>
                <StackPanel x:Name="MarcaMenu" DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,4,10,22">
                    <Border Style="{StaticResource MarcaQuadrado}">
                        <TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Mercado" FontWeight="Bold" FontSize="18" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Linha}" BorderThickness="0,1,0,0" Padding="0,16,0,0">
                    <StackPanel>
                        <DockPanel Margin="8,6">
                            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource Verde100}" Margin="0,0,10,0">
                                <TextBlock x:Name="Avatar" Foreground="{StaticResource Verde700}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="NomeUsuario" FontSize="14" FontWeight="Bold" />
                                <TextBlock x:Name="PerfilUsuario" FontSize="12" Style="{StaticResource TextoSuave}" />
                            </StackPanel>
                        </DockPanel>
                        <Button x:Name="BotaoSair" AutomationProperties.Name="Sair" Style="{StaticResource BotaoFantasma}" Foreground="{StaticResource Suave}" Height="38"
                                FontSize="14" Margin="0,10,0,0" Click="Sair_Click">
                            <StackPanel Orientation="Horizontal">
                                <ContentControl Style="{StaticResource Icone}" Tag="{StaticResource IconeSair}"
                                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="16" Margin="0,0,8,0" />
                                <TextBlock Text="Sair" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ItensMenu" />
            </DockPanel>
        </Border>

        <!-- Aviso rápido (toast) -->
        <Border x:Name="Toast" Grid.Row="1" Grid.ColumnSpan="2" Background="{StaticResource Tinta}" CornerRadius="10" Padding="18,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="ToastTexto" Foreground="White" FontSize="14" />
        </Border>
    </Grid>
</UserControl>
